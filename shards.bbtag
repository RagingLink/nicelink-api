{//;Help page}
{if;{logic;||;{flagset;h};{bool;{lower;{args;0}};==;help}};
  {embed;{embedbuild;
  title:Shards;
  url:https://blargbot.xyz/shards;
  author.icon_url:{useravatar}rl author.icon_url:{useravatar};
  author.name:{username};
  fields.name:Arguments;
  fields.value:- `bt shards` displays all shards and their statuses.
- `b!t shards help` displays this help page.
- `b!t shards [guild/cluster]` displays information of the provided guild/cluster with its shards.;
fields.name:Flags;
fields.value:- `-m/--meta` displays some metadata.
- `-d/--down` only displays the shards that are down.
- `-g/--guild [guild]` displays information about the current guild or provided guild.
- `-c/--cluster <cluster>` displays information about the provided cluster.
- `-s/--shard <shard>`  displays inforation about the provided shard.
- `-r/--raw` sends the shard data in JSON, can be combined with above flags. If more than one flag is provided, like `-rsc 2` the one highest in the list takes priority.
- `-h/--help` displays this help page.
Flags are ordered in priority.;
description:Please mention/dm RagingLink#9469 (`278237925009784832`) for any questions or bugs relating to `b!t shards` or the API this tag uses.;     color:{exec;dcolor};     timestamp:{time};     footer.text:Developed by RagingLink#9469;     footer.icon_url:{useravatar;278237925009784832}   }}   {return}
}
{//;Base API endpoint}  
{function;shards;
  {trim;
    {exec;motyar2;https://api.nicelink.xyz/blargbot/shards{params}}   
  }
}  
{//;Make sure output doesn't contain an error}
{function;response.error;   
  {if;{jget;{params};error};!=;;
    {edit;{channelid};{get;~id};{jget;{params};message}}     
    {return}   
  }
}
{function;shardOutput;     
  {if;{get;~id};==;;{set;~id;{output;{params}{exec;loading;10}}}}
}
{//;Raw flag handler. Meta -> Down -> Guild -> Cluster -> Shard -> Default}
{if;{flagset;r};
  {trim;     
    {switch;true;
      {flagset;m};     
        {func.shards;/meta};
      {flagset;d};
        {func.shards;?down=true};
      {flagset;g};
        {func.shards;?guild={if;{length;{flag;g}};!=;0;{flag;g};{guildid}}};
      {flagset;c};
        {func.shards;?cluster={flag;c}};
      {flagset;s};
        {func.shards;?shard={flag;s}};
      {func.shards}
    }
    {return;false}
  }
}
{//;Meta embed}
{if;{flagset;m};
  {func.shardOutput;Retrieving metadata}
  {set;~shardMetadata;{func.shards;/meta}}
  {set;~description;
    Clusters: {jget;~shardMetadata;clusters};
    Shards: {jget;~shardMetadata;shards};
    Shards per cluster: {jget;~shardMetadata;shardsPerCluster}
    Guilds: {jget;~shardMetadata;guilds};
    Users: {jget;~shardMetadata;users}
  }
  {if;{math;-;{time;x};{jget;~shardMetadata;lastMetaUpdate}};>;60000;       
    {set;~color;FF0000}     
  ;       
    {if;{math;-;{time;x};{jget;~shardMetadata;lastMetaUpdate}};>;30000;         
      {set;~color;FF8C00}       
    }     
  }
  {set;~embed;
    {buildembed;
      title:Metadata;
      description:{join;{get;~description};{newline}};
      color:{if;{get;~color};!=;;{get;~color};{exec;dcolor}};
      footer.text:Last update;
      footer.icon_url:{useravatar;134133271750639616};
      timestamp:{time;;{jget;~shardMetadata;lastMetaUpdate};x};
      author.icon_url:{useravatar};
      author.name:{username}#{userdiscrim};
      url:https://blargbot.xyz/shards 
    }
  }
  {edit;{channelid};{get;~id};{space};{get;~embed}}
  {return;false}
}
{//;Status emojifier}
{function;status;     
  {switch;{params};         
  ready;✅;
  disconnected;❌;          
  handshaking;🤝;
  connecting ;⌛;
  ❓}
}
{//;Check if output message exists}

{//;Used in viewing all shards}
{function;generalClusterInfo;   
  {set;~item;{params}}   
  {set;~output;[]}   
  {push;~output;
    Ready since: {time;DD/MM HH:mm;{jget;~item;readyTime};x};
    Ram:  {numformat;{math;/;{jget;~item;rss};1000000};0}MB;
    **Shards**:
  }   
  {set;~shards;
    {map;~shard;{jget;~item;shards};{realpad;Shard {math;-;{jget;~shard;id};0};8;{space}} {func.status;{jget;~shard;status}} - {jget;~shard;latency}ms}
  }   
  {push;~output;{repeat;`;3}{newline}{join;{get;~shards};{newline}}{repeat;`;3}}   
  {join;{slice;{get;~output};0};{newline}}
}
{//;More info per cluster}
{function;clusterInfo;   
  {set;~item;{params}}   
  {set;~output;[]}   
  {push;~output;
CPU usage: {numformat;{jget;~item;cpu};1}%
Ram used: {numformat;{math;/;{jget;~item;rss};1000000};0}MB
Guilds: {jget;~item;guilds}
Ready since: {time;DD/MM HH:mm;{jget;~item;readyTime};x}   
}   
  {set;~shards;
    {map;~shard;{jget;~item;shards};{realpad;Shard {math;-;{jget;~shard;id};0};8;{space}} {func.status;{jget;~shard;status}} - {jget;~shard;latency}ms}
  }   
  {push;~output;{repeat;`;3}{newline}{join;{get;~shards};{newline}}{repeat;`;3}}   
  {join;{slice;{get;~output};0};{newline}}
}
{//;Guild flag}
{if;{flagset;g};
  {if;{length;{flag;g}};==;0;
    {exec;shards;{guildid}}
    {return;false}
  ;
    {exec;shards;{flag;g}}
    {return;false}
  }
}
{//;Cluster flag}
{if;{flagset;c};
  {if;{length;{flag;c}};==;0;
    `Please provide a cluster`
    {return;false}
  }
  {exec;shards;{flag;c}}
  {return;false}
}
{//;Guild and cluster argument handler}
{if;{length;{flag;_}};!=;0;   
  {switch;{regextest;{args;0};/\d{17,23}/gmi};
    true;     	
      {set;~guild;{args;0}}     	
      {func.shardOutput;Looking up guild `{args;0}`}       
      {set;~shardResponse;{func.shards;?guild={args;0}}}
      {//;Response contains error?}       
      {func.response.error;{get;~shardResponse}}       
      {//;Embed for specified guild with cluster details}       
      {set;~embed;         
        {inject;{lb}embedbuild{semi}
          title:Guild information{semi}
          color:{if;{get;~color};!=;;{get;~color};{exec;dcolor}}{semi}
          description:Guild `{get;~guild}` is on cluster `{jget;~shardResponse;cluster.id}` and shard `{jget;~shardResponse;shard.id}`{semi}           
          fields.name:Info of cluster {jget;~shardResponse;cluster.id}{semi}
          fields.value:{func.clusterInfo;{jget;~shardResponse;cluster}}{semi}
          fields.inline:true{semi}
          footer.icon_url:{useravatar;134133271750639616}{semi}
          timestamp:{time;;{get;~lastUpdate};x}{semi}
          author.icon_url:{useravatar}{semi}
          author.name:{username}#{userdiscrim}{semi}
          url:https://blargbot.xyz/shards{rb}         
        }       
      }       
      {edit;{channelid};{get;~id};{space};{get;~embed}}       
      {return;false}              
    ;false;     	
      {set;~cluster;{parseint;{args;0}}}     	
      {func.shardOutput;Loading the cluster}
      {//;Formatted cluster info}     	
      {set;~shardResponse;{func.shards;?cluster={get;~cluster}}}
      {//;Response contains error?}       
      {func.response.error;{get;~shardResponse}}
      {//;Embed for specific cluster}       
      {set;~embed;         
        {inject;{lb}embedbuild{semi}
          title:Cluster info{semi}
          color:{if;{get;~color};!=;;{get;~color};{exec;dcolor}}{semi}
          description:{func.clusterInfo;{get;~shardResponse}}{semi}
          footer.icon_url:{useravatar;134133271750639616}{semi}
          timestamp:{time;;{get;~lastUpdate};x}{semi}
          author.icon_url:{useravatar}{semi}
          author.name:{username}#{userdiscrim}{semi}
          url:https://blargbot.xyz/shards{rb}
        }       
      }       
      {edit;{channelid};{get;~id};{space};{get;~embed}}       
      {return;false}   
  }
}
{//;Shard flag handler}
{if;{flagset;s};
  {if;{length;{flag;s}};==;0;
    `Please provide a shard`
    {return;false}
  }   	
  {func.shardOutput;Looking up shard}   	
  {set;~shard;{func.shards;?shard={flag;s}}}     
  {//;Shard errors}     
  {func.response.error;{get;~shard}}   	
  {set;~embed;         
    {embedbuild;          
      title:Shard {jget;~shard;id};            
      url:https://blargbot.xyz/shards;            
      description:Status: {func.status;{jget;~shard;status}}
Latency: {jget;~shard;latency}ms
Guilds: {jget;~shard;guilds}
Cluster: {jget;~shard;cluster}
Last update: {time;HH:mm DD/MM/YYYY;{jget;~shard;time};x};
      color:{exec;dcolor};             
      author.name:{username};            
      author.icon_url:{useravatar};             
      footer.icon_url:{useravatar;134133271750639616};             
      timestamp:{time}         
    }     
  }   	
  {edit;{channelid};{get;~id};{space};{get;~embed}} 	
  {return;false}
}
  
{set;~fields;[]}

{//;Load downed shards}
{if;{flagset;d};
  {func.shardOutput;Loading downed clusters}
  {set;~shardResponse;{func.shards;?down=true}}
  {//;Response contains error?}
  {func.response.error;{get;~shardResponse}}
  {//;Check if there are downed shards}
  {if;{length;{get;~shardResponse}};==;0;
    {edit;{channelid};{get;~id};{space};
      {buildembed;         
        title:Shards;
        description:{randchoose;No shards are currently down!;All shards are up and running!};
        color:{exec;dcolor};
        footer.icon_url:{useravatar;134133271750639616};
        author.icon_url:{useravatar};
        author.name:{username}#{userdiscrim};
        url:https://blargbot.xyz/shards
      }     
    }     
    {return;false}
  }
  {foreach;~item;{get;~shardResponse};       
    {jset;~field;name;Cluster {jget;~item;id};c}        
    {jset;~field;value;{func.generalClusterInfo;{get;~item}};c}       
    {jset;~field;inline;true;c}       
    {push;~fields;{get;~field}}     
  }
  {set;~lastUpdate;{shift;{sort;{slice;~updateTimes;0}}}}     
  {if;{math;-;{time;x};{get;~lastUpdate}};>;60000;       
    {set;~color;FF0000}     
  ;       
    {if;{math;-;{time;x};{get;~lastUpdate}};>;30000;         
      {set;~color;FF8C00}       
    }     
  }

  {set;~embed;       
    {inject;{lb}embedbuild{semi}
      title:Shards{semi}
      color:{if;{get;~color};!=;;{get;~color};{exec;dcolor}}{semi}        
      {foreach;~field;{get;~fields};{semi}
        fields.name:{jget;~field;name}{semi} 
        fields.value:{jget;~field;value}{semi} 
        fields.inline:true         
      }{semi}
      footer.text:Last update{semi}
      footer.icon_url:{useravatar;134133271750639616}{semi}
      timestamp:{time;;{get;~lastUpdate};x}{semi}
      author.icon_url:{useravatar}{semi}
      author.name:{username}#{userdiscrim}{semi}
      url:https://blargbot.xyz/shards{rb}       
    }     
  }     
  {edit;{channelid};{get;~id};{space};{get;~embed}}     
  {return;false}
}
{//;Load all clusters+shards}
{func.shardOutput;Loading the clusters}
{set;~shardResponse;{func.shards;{if;{flagset;d};?down=true}}}
{//;Response contains error?}
{func.response.error;{get;~shardResponse}}   	

{set;~shardMetaData;{func.shards;/meta}}
{set;~fields;[]}
{set;~shardCount;{jget;~shardMetaData;shards}}  
{set;~updateTimes;{map;~c;~shardResponse;{jget;~c;time}}}
{if;{isarray;{get;~shardResponse}};   
  {foreach;~item;{get;~shardResponse};       
    {jset;~field;name;Cluster {jget;~item;id};c}        
    {jset;~field;value;{func.generalClusterInfo;{get;~item}};c}       
    {jset;~field;inline;true;c}       
    {push;~fields;{get;~field}}     
  }     
  {set;~lastUpdate;{shift;{sort;{slice;~updateTimes;0}}}}     
  {if;{math;-;{time;x};{get;~lastUpdate}};>;60000;       
    {set;~color;FF0000}     
  ;       
    {if;{math;-;{time;x};{get;~lastUpdate}};>;30000;         
      {set;~color;FF8C00}       
    }     
  }     
  {set;~embed;       
    {inject;{lb}embedbuild{semi}
      title:Shards{semi}
      color:{if;{get;~color};!=;;{get;~color};{exec;dcolor}}{semi}
      description:{if;{isarray;{get;~shardResponse}};I\'m running on {jget;~shardMetaData;clusters} clusters and {get;~shardCount} shards
This guild is on shard {floor;{math;%;{math;/;{guildid};4194304};{get;~shardCount}}};
        The API appears to be down, please mention {usermention;278237925009784832} `(278237925009784832)` to get this resolved ASAP}         
      {foreach;~field;{get;~fields};{semi}
        fields.name:{jget;~field;name}{semi} 
        fields.value:{jget;~field;value}{semi} 
        fields.inline:true         
      }{semi}
      footer.text:Last update{semi}
      footer.icon_url:{useravatar;134133271750639616}{semi}
      timestamp:{time;;{get;~lastUpdate};x}{semi}
      author.icon_url:{useravatar}{semi}
      author.name:{username}#{userdiscrim}{semi}
      url:https://blargbot.xyz/shards{rb}       
    }     
  }     
  {edit;{channelid};{get;~id};{space};{get;~embed}}     
  {return;false}        
} 
{edit;{channelid};{get;~id};{space};{exec;shard.down.embed}}
{return;false}